# Production / shared-hosting template.
# Copy to .env on the server and fill real values. Never commit .env.
# Local XAMPP development should keep using .env.example → .env with APP_ENV=local.

APP_ENV=production
APP_NAME="Global Health and Education clinic"

# Staff session lifetime in seconds (default 8 hours).
ADMIN_SESSION_LIFETIME=28800

# NEVER enable demo seeding outside APP_ENV=local.
ADMIN_SEED_ENABLED=false
# Leave seed credentials empty in production — create the first super_admin
# with scripts/create_first_super_admin.php or the SQL steps in docs/DEPLOY.md.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_ROLE=super_admin

# MariaDB — use a non-root app user with a strong password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinic_db
DB_USER=clinic_app
DB_PASSWORD=

# --- SMS (keep mock/off until clinic/legal + Twilio production setup) ---
SMS_ENABLED=false
SMS_MODE=mock
SMS_LIVE_BREAK_GLASS=false
SMS_TIMEOUT_SECONDS=15
SMS_REMINDER_DAYS_AHEAD=2
# Exact public HTTPS URL of public/api/sms_webhook.php (Twilio Console must match).
SMS_WEBHOOK_URL=https://your.domain.example/api/sms_webhook.php
SMS_TWILIO_TRIAL_MODE=false
SMS_TWILIO_TRIAL_TEMPLATE=sms_appointment_reminders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TRIAL_TO=
