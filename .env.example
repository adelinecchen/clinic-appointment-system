# Copy this file to .env for local development:
#   cp .env.example .env
# .env is gitignored. Do not put real passwords in this example file.

APP_ENV=local
APP_NAME="Global Health and Education clinic"

# Staff desk login. Leave these as the local demo values, or change them here.
# Do not put a real clinic password in this example file.
ADMIN_USERNAME=staff
ADMIN_PASSWORD=clinic-desk

# Database connection used by src/db.php (PDO).
# These are local XAMPP defaults. Match them to your MariaDB user.
# XAMPP's MySQL/MariaDB usually listens on 127.0.0.1 port 3306.
# The default XAMPP root password is often empty.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinic_db
DB_USER=root
DB_PASSWORD=
