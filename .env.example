# Copy this file to .env for local development:
#   cp .env.example .env
# .env is gitignored. Do not put real passwords in this example file.

APP_ENV=local
APP_NAME="Global Health and Education clinic"

# Staff session lifetime in seconds (default 8 hours).
ADMIN_SESSION_LIFETIME=28800

# Local demo Admin seed — only runs when APP_ENV=local AND ADMIN_SEED_ENABLED=true
# and the Admin table is empty. Leave ADMIN_SEED_ENABLED=false for any shared or
# production-like environment. Set a strong password in .env; do not commit it.
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=desk@clinic.local
ADMIN_PASSWORD=
ADMIN_NAME=Front desk
ADMIN_PHONE=5550100000
ADMIN_ROLE=super_admin

# Database connection used by src/db.php (PDO).
# These are local XAMPP defaults. Match them to your MariaDB user.
# XAMPP's MySQL/MariaDB usually listens on 127.0.0.1 port 3306.
# The default XAMPP root password is often empty.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinic_db
DB_USER=root
DB_PASSWORD=

# --- SMS (Twilio Programmable Messaging) ---
# Keep SMS_ENABLED=false until the clinic has: BAA (Security/Enterprise), HIPAA
# project designation, A2P 10DLC brand/campaign registration, consent language
# approved, and a production From number. Mock mode never calls Twilio.
SMS_ENABLED=false
SMS_MODE=mock
SMS_TIMEOUT_SECONDS=15
SMS_REMINDER_DAYS_AHEAD=2
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Optional test hooks: auth | timeout | request
# SMS_FORCE_FAIL=
