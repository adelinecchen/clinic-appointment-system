# Copy this file to .env for local development:
#   cp .env.example .env
# .env is gitignored. Do not put real passwords in this example file.

APP_ENV=local
APP_NAME="Global Health and Education clinic"

# Staff session lifetime in seconds (default 8 hours).
ADMIN_SESSION_LIFETIME=28800

# Local demo Admin seed — only runs when APP_ENV=local AND ADMIN_SEED_ENABLED=true
# and the Admin table is empty. Leave ADMIN_SEED_ENABLED=false for any shared or
# production-like environment. Set a strong password in .env; do not commit it.
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=demo@clinic.local
ADMIN_PASSWORD=demoaccount
ADMIN_NAME=Demo Account
ADMIN_PHONE=5550100000
ADMIN_ROLE=super_admin

# Database connection used by src/db.php (PDO).
# These are local XAMPP defaults. Match them to your MariaDB user.
# XAMPP's MySQL/MariaDB usually listens on 127.0.0.1 port 3306.
# The default XAMPP root password is often empty.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinic_db
DB_USER=root
DB_PASSWORD=

# --- SMS (Twilio Programmable Messaging) ---
# Default stays mock/off. For a local trial against your own verified phone:
#   SMS_ENABLED=true
#   SMS_MODE=live
#   fill TWILIO_* from console.twilio.com
#   SMS_TRIAL_TO=+1...  (must be a Verified Caller ID on free/trial accounts)
# Production clinic use still needs BAA / HIPAA project / A2P 10DLC separately.
# This project sends via curl in src/sms.php — no Composer Twilio SDK required.
SMS_ENABLED=false
SMS_MODE=mock
# Live Twilio sends also require APP_ENV=production, or this break-glass for local trials only:
SMS_LIVE_BREAK_GLASS=false
SMS_TIMEOUT_SECONDS=15
SMS_REMINDER_DAYS_AHEAD=2
# Public HTTPS URL of public/api/sms_webhook.php — must match Twilio Console exactly
# (Phone Numbers → Active number → Messaging → “A message comes in” / status callback).
# Used for X-Twilio-Signature validation; never derived from the HTTP Host header.
# Example: https://your.domain.example/api/sms_webhook.php
SMS_WEBHOOK_URL=
# Free trial: Body must be a Twilio template key (e.g. sms_appointment_reminders).
SMS_TWILIO_TRIAL_MODE=true
SMS_TWILIO_TRIAL_TEMPLATE=sms_appointment_reminders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TRIAL_TO=
# Optional test hooks: auth | timeout | request
# SMS_FORCE_FAIL=
