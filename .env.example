# Copy this file to .env for local development:
#   cp .env.example .env
# .env is gitignored. Do not put real passwords in this example file.

APP_ENV=local
APP_NAME="Clinic Appointment System"

# Database connection used later by the PHP backend.
# Leave the name, user, and password blank until the database is created.
# XAMPP's MySQL/MariaDB usually listens on 127.0.0.1 port 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
